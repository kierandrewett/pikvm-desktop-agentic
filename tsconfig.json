{
    // Visit https://aka.ms/tsconfig to read more about this file
    "compilerOptions": {
        // File Layout
        "rootDir": ".",
        "outDir": "./dist",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/sidebar/*"],
            // The host sees the declaration, not the lifted server (see that file).
            "@pikvm/chat-server": ["./packages/chat-server/host.d.ts"]
        },

        // Environment Settings
        // See also https://aka.ms/tsconfig/module
        // esbuild bundles everything under src/, so module resolution is the bundler's: the workspace
        // packages (kvm-engine, chat-*) are TypeScript source with extensionless imports, which the
        // node16 rules reject.
        "target": "ES2022",
        "module": "esnext",
        "moduleResolution": "bundler",
        "types": ["node", "electron"],
        "lib": ["ES2024", "DOM"],
        // Other Outputs
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,

        // Stricter Typechecking Options
        "noUncheckedIndexedAccess": true,
        "exactOptionalPropertyTypes": true,

        // Style Options
        // "noImplicitReturns": true,
        // "noImplicitOverride": true,
        // "noUnusedLocals": true,
        // "noUnusedParameters": true,
        // "noFallthroughCasesInSwitch": true,
        // "noPropertyAccessFromIndexSignature": true,

        // Recommended Options
        "strict": true,
        "jsx": "react-jsx",
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "moduleDetection": "force",
        "skipLibCheck": true
    },
    // Source lives in src/; scripts/ are esbuild-bundled smoke tests, not part of
    // the app typecheck. rootDir is the repo root because src/ imports the
    // @pikvm/contracts workspace package, whose source sits outside src/.
    //
    // agent/ is the daemon subtree and owns its own toolchain: a Python package
    // plus a Vite/React app with its own tsconfig, JSX runtime and lib set. The
    // default "**/*" include swallowed it the moment it landed in this repo, and
    // its .tsx files do not compile under this project's settings. Its typecheck
    // runs from agent/frontend, not from here.
    //
    // apps/, packages/ and tools/ are workspaces with their own tsconfigs and
    // environments (DOM, Vite, vitest); this project only reaches the ones the
    // server imports, through the import graph.
    "exclude": ["scripts", "tests", "dist", "node_modules", "agent", "apps", "packages", "tools"]
}
