        "@pikvm/contracts": "workspace:*",
        "@types/node": "^25.0.3",
        "@types/web-push": "^3",
        "@types/ws": "^8.18.1",
        "electron": "^39.2.7",
        "electron-builder": "^26.18.0",
        "esbuild": "^0.27.2",
        "typescript": "^5.9.3",
        "web-push": "^3.6.7"
