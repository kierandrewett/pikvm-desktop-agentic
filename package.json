{
    "name": "pikvm-desktop-agentic",
    "description": "PiKVM desktop client — a managed agent chat with live computer context",
    "version": "1.14.0",
    "main": "main.js",
    "bin": {
        "pikvm": "bin/pikvm"
    },
    "repository": "https://github.com/kierandrewett/pikvm-desktop-agentic",
    "author": "kierandrewett <kieran@drewett.dev>",
    "license": "MIT",
    "private": true,
    "packageManager": "yarn@4.17.1",
    "workspaces": [
        "packages/*",
        "apps/*"
    ],
    "scripts": {
        "start": "electron dist",
        "build": "node scripts/build.mjs",
        "inspect:cdp": "node scripts/inspect-electron-cdp.mjs",
        "test": "node scripts/test.mjs",
        "package": "node scripts/package.mjs"
    },
    "dependencies": {
        "@lydell/node-pty": "^1.1.0",
        "axios": "^1.13.2",
        "web-haptics": "^0.0.6",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@electron/packager": "^19.0.1",
        "@pikvm/contracts": "workspace:*",
        "@types/node": "^25.0.3",
        "@types/ws": "^8.18.1",
        "electron": "^39.2.7",
        "esbuild": "^0.27.2",
        "typescript": "^5.9.3"
    },
    "resolutions": {
        "@assistant-ui/core": "0.2.22",
        "@assistant-ui/store": "0.2.21",
        "@assistant-ui/tap": "0.9.5"
    }
}
