{
    "name": "pikvm-desktop-agentic",
    "description": "PiKVM Desktop Client with an integrated AI agent (Pi harness + MCP)",
    "version": "1.6.0",
    "main": "main.js",
    "repository": "https://github.com/kierandrewett/pikvm-desktop-agentic",
    "author": "kierandrewett <kieran@drewett.dev>",
    "license": "MIT",
    "scripts": {
        "start": "electron dist",
        "build": "node scripts/build.mjs",
        "smoke:proxy": "esbuild scripts/smoke-proxy.ts --bundle --platform=node --format=cjs --outfile=dist/smoke-proxy.cjs --alias:electron=./scripts/electron-stub.cjs --log-level=error && node dist/smoke-proxy.cjs",
        "smoke:console": "esbuild scripts/console-test.ts --bundle --platform=node --format=cjs --outfile=dist/console-test.cjs --log-level=error && node dist/console-test.cjs",
        "package:linux": "make package",
        "postinstall": "patch-package",
        "smoke:atlas": "esbuild scripts/atlas-mcp-test.ts --bundle --platform=node --format=cjs --outfile=dist/atlas-mcp-test.cjs --log-level=error && node dist/atlas-mcp-test.cjs",
        "smoke:atlas-mirror": "esbuild scripts/atlas-mirror-test.ts --bundle --platform=node --format=cjs --outfile=dist/atlas-mirror-test.cjs --log-level=error && node dist/atlas-mirror-test.cjs",
        "smoke:typing": "esbuild scripts/watched-typing-test.ts --bundle --platform=node --format=cjs --outfile=dist/watched-typing-test.cjs --alias:electron=./scripts/electron-stub.cjs --log-level=error && node dist/watched-typing-test.cjs",
        "smoke:autonomy": "esbuild scripts/autonomy-classifier-test.ts --bundle --platform=node --format=cjs --outfile=dist/autonomy-classifier-test.cjs --log-level=error && node dist/autonomy-classifier-test.cjs"
    },
    "dependencies": {
        "@ai-sdk/react": "^3.0.209",
        "@earendil-works/pi-agent-core": "^0.79.6",
        "@earendil-works/pi-ai": "^0.79.6",
        "@modelcontextprotocol/sdk": "^1.29.0",
        "@radix-ui/react-collapsible": "^1.1.14",
        "@radix-ui/react-slot": "^1.3.0",
        "@radix-ui/react-use-controllable-state": "^1.2.3",
        "@tanstack/react-virtual": "^3.14.3",
        "ai": "^6.0.207",
        "axios": "^1.13.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "hono": "^4.12.25",
        "lucide-react": "^1.20.0",
        "motion": "^12.40.0",
        "nodejs-whisper": "^0.3.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "shiki": "^4.2.0",
        "streamdown": "^2.5.0",
        "tailwind-merge": "^3.6.0",
        "tesseract.js": "^7.0.0",
        "use-stick-to-bottom": "^1.1.6",
        "ws": "^8.21.0"
    },
    "devDependencies": {
        "@electron/packager": "^19.0.1",
        "@tailwindcss/cli": "^4.3.1",
        "@types/node": "^25.0.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/ws": "^8.18.1",
        "electron": "^39.2.7",
        "electron-installer-flatpak": "^0.8.0",
        "electron-installer-redhat": "^3.4.0",
        "esbuild": "^0.27.2",
        "patch-package": "^8.0.1",
        "tailwindcss": "^4.3.1",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3"
    }
}
