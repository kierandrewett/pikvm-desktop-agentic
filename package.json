{
    "name": "pikvm-desktop-agentic",
    "description": "PiKVM desktop client — a managed agent chat with live computer context",
    "version": "1.15.14",
    "main": "main.js",
    "bin": {
        "pikvm": "bin/pikvm"
    },
    "repository": "https://github.com/kierandrewett/pikvm-desktop-agentic",
    "author": "kierandrewett <kieran@drewett.dev>",
    "license": "MIT",
    "private": true,
    "packageManager": "yarn@4.17.1",
