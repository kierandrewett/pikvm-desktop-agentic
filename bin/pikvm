#!/usr/bin/env bash
#
# pikvm - one command for the desktop app and the agent CLI.
#
#   pikvm             launch the desktop app
#   pikvm cli ...     run the agent CLI, arguments passed straight through
#
# The app and the daemon are one product, so they get one entrypoint. Keep the
# dispatch here dumb: anything clever belongs in the app or in the CLI, never in
# the thing that only has to choose between them.
set -euo pipefail

root="$(cd "$(dirname "$0")/.." && pwd)"

usage() {
    cat <<'EOF'
pikvm - PiKVM desktop app and agent CLI

  pikvm                 launch the desktop app
  pikvm cli [args...]   run the agent CLI (try: pikvm cli --help)

The desktop app spawns and owns the daemon; you do not need to start it
yourself.
EOF
}

# The SAME preference order as agentExecutables() in src/main.ts, and a test
# pins the two together. A launcher that finds a different installation from the
# app it launches is worse than one that finds nothing: both would appear to
# work, on different builds.
agent_executable() {
    if [ -n "${PIKVM_AGENT_DAEMON_CMD:-}" ] && [ -x "${PIKVM_AGENT_DAEMON_CMD}" ]; then
        printf '%s\n' "${PIKVM_AGENT_DAEMON_CMD}"
        return
    fi
    for candidate in \
        "${root}/agent/.venv/bin/pikvm-agent" \
        "${HOME}/dev/pikvm-agent/.venv/bin/pikvm-agent"; do
        if [ -x "${candidate}" ]; then
            printf '%s\n' "${candidate}"
            return
        fi
    done
    printf 'pikvm-agent\n' # rely on PATH
}

run_cli() {
    local exe
    exe="$(agent_executable)"
    if [ "${exe}" = "pikvm-agent" ] && ! command -v pikvm-agent >/dev/null 2>&1; then
        echo "[pikvm] no agent installation found." >&2
        echo "[pikvm] looked in: \$PIKVM_AGENT_DAEMON_CMD, ${root}/agent/.venv, ~/dev/pikvm-agent/.venv, \$PATH" >&2
        echo "[pikvm] set one up with: cd ${root}/agent && uv sync" >&2
        exit 127
    fi
    exec "${exe}" "$@"
}

run_desktop() {
    # The local Electron first so a dev checkout runs the version it was built
    # against, rather than whatever happens to be installed globally.
    local electron="${root}/node_modules/.bin/electron"
    if [ ! -x "${electron}" ]; then
        if command -v electron >/dev/null 2>&1; then
            electron="$(command -v electron)"
        else
            echo "[pikvm] electron not found. Run 'yarn install' in ${root}." >&2
            exit 127
        fi
    fi
    if [ ! -d "${root}/dist" ]; then
        echo "[pikvm] ${root}/dist is missing. Run 'yarn build' first." >&2
        exit 127
    fi
    exec "${electron}" "${root}/dist" "$@"
}

case "${1:-}" in
    cli)
        shift
        run_cli "$@"
        ;;
    -h | --help | help)
        usage
        ;;
    *)
        run_desktop "$@"
        ;;
esac
