# Sidebar chat hover card (components/sidebar/chat-hover-card.tsx).

hover-card-untitled = New chat
hover-card-unavailable = Preview unavailable
hover-card-waiting = Waiting for the first reply
hover-card-empty = No messages yet
hover-card-loading = Loading preview
hover-card-responding = Responding
hover-card-messages =
    { $count ->
        [one] { $count } message
       *[other] { $count } messages
    }
hover-card-attachments-title =
    { $count ->
        [one] { $count } attachment
       *[other] { $count } attachments
    }
hover-card-attachments-label = Attachments:
hover-card-files-title =
    { $count ->
        [one] { $count } file edited
       *[other] { $count } files edited
    }
hover-card-files-label = Files edited:
