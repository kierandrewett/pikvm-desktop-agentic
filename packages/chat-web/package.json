{
    "name": "@pikvm/chat-web",
    "version": "0.0.0",
    "private": true,
    "description": "The Chat tab's conversation interface, lifted from an upstream chat project and scoped to one pane",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "exports": {
        ".": "./src/index.ts",
        "./settings": "./src/settings.ts",
        "./testing": "./src/testing.ts"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "vitest run"
    },
    "dependencies": {
        "@fluent/bundle": "0.19.1",
        "@fluent/react": "0.15.2",
        "@pikvm/chat-protocol": "workspace:*",
        "@pikvm/icons": "workspace:*",
        "@tanstack/react-query": "^5.105.1",
        "@tanstack/react-router": "^1.170.46",
        "@tanstack/react-virtual": "3.13.12",
        "katex": "0.16.22",
        "radix-ui": "^1.8.1",
        "react": "^19",
        "react-dom": "^19",
        "react-markdown": "10.1.0",
        "remark-gfm": "4.0.1",
        "remark-math": "6.0.0",
        "shiki": "4.5.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "jsdom": "^30.1.3",
        "typescript": "^5.9.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    }
