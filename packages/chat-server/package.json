        "ws": "^8.21.0",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/node": "^25.0.3",
        "@types/ws": "^8.18.1",
        "typescript": "^5.9.3",
        "vitest": "^5.0.5"
    }
}
